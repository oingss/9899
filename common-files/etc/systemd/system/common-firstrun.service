[Unit]
Description=Common first-run initialization (SSH keys, UUID, etc.)
After=local-fs.target systemd-modules-load.target
Before=network-pre.target
ConditionPathExists=!/var/lib/common-firstrun-done

[Service]
Type=oneshot
ExecStart=/usr/lib/common/firstrun start
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
